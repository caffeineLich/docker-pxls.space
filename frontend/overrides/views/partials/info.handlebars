    </header>
    <div class="pad-wrapper">
        <ol>
            <li>{{{i18n 'Do not write anything that is prohibited on Twitch;'}}}</li>
            <li>{{{i18n 'Do not insult anyone;'}}}</li>
            <li>{{{i18n 'Just do not write bullshit, come on guys;'}}}</li>
        </ol>
    </div>
</article>
